<?xml version="1.0" encoding="UTF-8"?>
<LogConfig isManul="true">
    <!--false:调用log4cpp.properties, true:使用manul加载本文件中的配置-->
    <LogPrintLV>0</LogPrintLV>
    <!--调试信息打印输出等级-->
    <LogWriteLV>0</LogWriteLV>
    <!--调试信息日志存储等级-->
    <LogWriteEnable>true</LogWriteEnable>
    <!--日志写文件使能-->
    <LogSocketEnable>true</LogSocketEnable>
    <!--socket输出使能-->
    <CategorySocket>
        <port>5589</port>
    </CategorySocket>
    <PrintAppender>
        <layout>%d (%p) %x: %m%n</layout>
    </PrintAppender>
    <RollingFileAppender>
        <fileName>/home/lw/WORK_Claude/07_StreamServerLite/ffmpegRtspServer/10_dataServer/log/log</fileName>
        <maxFileSize>2097152</maxFileSize>
        <maxBackupIndex>30</maxBackupIndex>
        <layout>%d (%p) %x: %m%n</layout>
    </RollingFileAppender>
    <SyslogAppender>
        <fileName>/home/lw/WORK_Claude/07_StreamServerLite/ffmpegRtspServer/10_dataServer/log/syslog.log</fileName>
        <maxFileSize>2097152</maxFileSize>
        <maxBackupIndex>10</maxBackupIndex>
        <priority>400</priority>
        <layout>%d (%p) %x: %m%n</layout>
    </SyslogAppender>
</LogConfig>
