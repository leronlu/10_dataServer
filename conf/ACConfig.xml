<?xml version="1.0" encoding="UTF-8"?>
<ACConfig>
	<beamEnable>true</beamEnable>
	<wavType>32</wavType>
	<streamProc>0</streamProc>
	<connect enable="true" ip="192.168.1.222" port="8888" netNum="3" timeOut="3" TestMode="false" />
	
	<pwmFilePath>/sys/class/backlight/backlight-edp1/brightness</pwmFilePath>
	
	<tempFilePath>/sys/devices/virtual/thermal/thermal_zone0/temp</tempFilePath>
	
    <PollingTime>1</PollingTime>
	
    <AckSendTime>200</AckSendTime>
    <!--Modubus应答延时发送插入帧时间 毫秒-->
    <ReceiveOverTime>1</ReceiveOverTime>
    <!--Modubus客户端抄表的接收超时时间秒-->
    <YkOverTime>5</YkOverTime>
    <!--Modubus客户端遥控执行命令的超时时间 秒-->

    <DelaySend>2</DelaySend>
    <!--请求帧延时发送-->
	
	<!-- 声音再空气中传播的阻抗-->
	<Impedance>400</Impedance>
	
	<!-- 参考声压平方 20E-6 -->
	<referencePressure>20</referencePressure>
	
	<!--传感器数目 须与readData中yx yc数目一致 -->
	<SersorNum>128</SersorNum>
	
	<!-- FFT计算长度 -->
	<FFTLen>256</FFTLen>
	
	<!-- 声音采样率 -->
	<SoundFs>96000</SoundFs>
	
	<!-- 传感器故障检测的最低声压级 -->
	<FaultDetectMinSound>20</FaultDetectMinSound>
	
	<!-- 传感器故障检测的 偏差百分比 -->
	<FaultDetectPerAge>50</FaultDetectPerAge>

    <CommunicateStatReport enable="true" trytimes="3"/>
    <!--通信状态上报-->

    <BaseAddr>
        <!--relate:相对前一个下行模块偏移,absolute:绝对地址相对于上行协议配置基址偏移-->
        <YxBaseAddr type="relate">0</YxBaseAddr>
        <YkBaseAddr type="relate">0</YkBaseAddr>
    </BaseAddr>
    <parseMode>1</parseMode>
  
	<dataMsg>
		<!-- RTU IPC 遥测 15 槽 (Issue #4, 2026-08-14): 槽位顺序须与 VideoFusionYcIndex 枚举一致,
			 遥信已下线(原 128 路 yx1/128 路声压 yc1 删除), 数据源为 /tmp/rtumsg 消息队列 -->
		<frame type="readData">
			<data regIndex="0" len="0x02" type="yc" defaultValue="60" repeat="1" desc="rainbow dot max" />
			<data regIndex="1" len="0x02" type="yc" defaultValue="59" repeat="1" desc="rainbow dot min" />
			<data regIndex="2" len="0x02" type="yc" defaultValue="1400" repeat="1" desc="capacity" />
			<data regIndex="3" len="0x02" type="yc" defaultValue="40" repeat="1" desc="cpu temp" />
			<data regIndex="4" len="0x02" type="yc" defaultValue="0" repeat="1" desc="distant" />
			<data regIndex="5" len="0x02" type="yc" defaultValue="0" repeat="1" desc="max pressure X" />
			<data regIndex="6" len="0x02" type="yc" defaultValue="0" repeat="1" desc="max pressure Y" />
			<data regIndex="7" len="0x02" type="yc" defaultValue="0" repeat="1" desc="min pressure X" />
			<data regIndex="8" len="0x02" type="yc" defaultValue="0" repeat="1" desc="min pressure Y" />
			<data regIndex="9" len="0x02" type="yc" defaultValue="0" repeat="1" desc="prpd type" />
			<data regIndex="10" len="0x02" type="yc" defaultValue="0" repeat="1" desc="confidence" />
			<data regIndex="11" len="0x02" type="yc" defaultValue="0" repeat="1" desc="LRQ" />
			<data regIndex="12" len="0x02" type="yc" defaultValue="0" repeat="1" desc="leak" />
			<data regIndex="13" len="0x02" type="yc" defaultValue="0" repeat="1" desc="gas economic loss" />
			<data regIndex="14" len="0x02" type="yc" defaultValue="0" repeat="1" desc="energy economic loss" />
		</frame>

		<frame type="readParam">
			<data regIndex="6" value="0x00000000" type="INT32U" qpm="126" />
			<data regIndex="7" value="0x00000001" type="INT32U" qpm="127"  />
			<data regIndex="8" value="0x00000002" type="INT32U" qpm="128" />
			<data regIndex="9" value="0x00000003" type="INT32U" qpm="129"  />
			<data regIndex="10" value="0x00000004" type="INT32U" qpm="130" />
			<data regIndex="11" value="0x00000005" type="INT32U" qpm="131"  />
			<data regIndex="12" value="0x00000006" type="INT32U" qpm="132" />
			<data regIndex="13" value="0x00000007" type="INT32U" qpm="133"  />
			<data regIndex="14" value="0x00000008" type="INT32U" qpm="134" />
			<data regIndex="15" value="0x00000009" type="INT32U" qpm="135"  />
		</frame>
	</dataMsg>
	
</ACConfig>
